    "@kamaalio/hono-standard-openapi": "^0.0.15",
    "@kamaalio/kamaal": "~0.9.11",
    "@kamaalio/kamaal-auth-hono": "~0.0.9",
    "better-auth": "1.7.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "js-yaml": "^5.4.1",
    "neverthrow": "^8.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.4.1",
