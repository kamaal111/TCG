{
  "name": "tcg",
  "version": "1.0.0",
  "keywords": [],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "server": "pnpm --filter tcg-server"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/structured-logger": "catalog:",
    "@hono/swagger-ui": "catalog:",
    "@kamaalio/hono-standard-openapi": "catalog:",
    "@kamaalio/kamaal": "catalog:",
    "@kamaalio/kamaal-auth-core": "catalog:",
    "@kamaalio/kamaal-auth-hono": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "js-yaml": "catalog:",
    "neverthrow": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devcontainers/cli": "catalog:",
    "@kamaal111/kamaal-quality-config": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "catalog:",
    "smol-toml": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.1",
      "onFail": "error"
    }
  }
}
