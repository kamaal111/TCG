{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "TCG",
  "dockerComposeFile": ["compose.services.yaml", "compose.yaml"],
  "service": "devcontainer",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "root",
  "shutdownAction": "stopCompose",
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "just start-services",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "root",
      "installZsh": true,
      "installOhMyZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/mise:1": {},
    "ghcr.io/guiyomh/features/just:0": {},
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "git zsh-autosuggestions zsh-syntax-highlighting",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions https://github.com/zsh-users/zsh-syntax-highlighting"
    }
  },
  "overrideFeatureInstallOrder": ["ghcr.io/devcontainers/features/common-utils"],
  "containerEnv": {
    "MISE_EXPERIMENTAL": "1",
    "PATH": "/root/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "forwardPorts": ["db:5432", "garage:3900"],
  "portsAttributes": {
    "db:5432": { "label": "PostgreSQL" },
    "garage:3900": { "label": "Garage S3" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "vitest.explorer",
        "ms-azuretools.vscode-containers",
        "redhat.vscode-yaml",
        "swiftlang.swift-vscode",
        "nefrob.vscode-just-syntax",
        "yoavbls.pretty-ts-errors",
        "anthropic.claude-code",
        "openai.chatgpt",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.oxc": "explicit"
        },
        "[swift]": {
          "editor.defaultFormatter": "swiftlang.swift-vscode"
        }
      }
    },
    "zed": {
      "extensions": ["oxc", "swift", "just"]
    }
  }
}
