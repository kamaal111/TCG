NODE_ENV=production
PORT=8080
DATABASE_URL="postgresql://{{ database_user | urlencode | replace('/', '%2F') }}:{{ database_password | urlencode | replace('/', '%2F') }}@{{ database_host }}:{{ database_port }}/{{ database_name | urlencode | replace('/', '%2F') }}?sslmode=verify-full&sslrootcert=/run/tcg/database-ca.crt"
DATABASE_CONNECTION_TIMEOUT_MS=10000
BETTER_AUTH_URL={{ ('https://' + api_hostname) if api_hostname else 'http://127.0.0.1:8080' }}
BETTER_AUTH_SECRET={{ auth_secret.content | b64decode | trim }}
OBJECT_STORAGE_ENDPOINT={{ object_storage_endpoint }}
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET={{ object_storage_bucket }}
OBJECT_STORAGE_ACCESS_KEY_ID={{ object_storage_access_key }}
OBJECT_STORAGE_SECRET_ACCESS_KEY={{ object_storage_secret_key }}
OBJECT_STORAGE_FORCE_PATH_STYLE=false
