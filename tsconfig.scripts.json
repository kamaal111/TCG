{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "vitest.config.ts",
    "scripts/build-server-image.ts",
    "scripts/build-server-image.test.ts",
    "scripts/check-server-image-health.ts",
    "scripts/check-localizations.ts",
    "scripts/check-localizations.test.ts",
    "scripts/create-herdr-worktree.ts",
    "scripts/create-herdr-worktree.test.ts",
    "scripts/check-versions-in-sync.ts",
    "scripts/check-versions-in-sync.test.ts"
  ]
}
