PORT=8080
DATABASE_URL=postgresql://tcg_user:tcg_password@localhost:5432/tcg
BETTER_AUTH_URL=http://localhost:8080
# PUBLIC_BASE_URL=https://assets.example.com
DEBUG=true

# Recommend: pnpm exec auth secret
BETTER_AUTH_SECRET=secret

# SCRYDEX_CLIENT=real
# Create credentials at https://scrydex.com before using the real API.
# SCRYDEX_API_KEY=
# SCRYDEX_TEAM_ID=

# Compose-managed local Garage object storage.
# TCG_STORAGE_PORT=9000

# Object storage is the only card-image backend. The server refuses to start without
# an endpoint and credentials; `just start-services` brings up the Garage these point at.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=tcg-card-images
OBJECT_STORAGE_ACCESS_KEY_ID=GK0E6CA7DF3BA4C6B0A243
OBJECT_STORAGE_SECRET_ACCESS_KEY=6691f95e22fc407da42ec11cbafc2698d441055fd1f462c750581d7232a486a0
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_REQUEST_TIMEOUT_MS=5000
# OBJECT_STORAGE_MAX_ATTEMPTS=2
# CARD_IMAGE_MAX_BYTES=5242880
# CARD_IMAGE_REQUEST_TIMEOUT_MS=8000
# Per instance, so origin load is this times the number of instances running the warmer.
# CARD_IMAGE_WARM_CONCURRENCY=2
# CARD_IMAGE_LEASE_DURATION_MS=30000
# CARD_IMAGE_WORKER_POLL_INTERVAL_MS=5000
# CARD_IMAGE_FOREGROUND_WAIT_MS=10000
# Every instance warms images by default. Set false on web instances to run a dedicated worker
# deployment instead; see server/docs/card-images.md.
# CARD_IMAGE_WORKER_ENABLED=true
# Retries back off exponentially from RETRY_AFTER up to MAX_RETRY_AFTER; past MAX_ATTEMPTS the
# image is abandoned and the proxy answers 404.
# CARD_IMAGE_MAX_ATTEMPTS=5
# CARD_IMAGE_RETRY_AFTER_MS=300000
# CARD_IMAGE_MAX_RETRY_AFTER_MS=21600000
# CARD_IMAGE_WARM_ON_REGISTER=true
